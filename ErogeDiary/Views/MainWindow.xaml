<Window x:Class="ErogeDiary.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:local="clr-namespace:ErogeDiary.Views"
        xmlns:properties="clr-namespace:ErogeDiary.Properties"
        xmlns:input="clr-namespace:ErogeDiary.Views.Input"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Background="#1f2022"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:ThemeManager.RequestedTheme="Dark"
        ui:ThemeManager.IsThemeAware="True"
        ui:TitleBar.ExtendViewIntoTitleBar="True"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Title="ErogeDiary" Height="515" Width="830" 
    MinWidth="640" MinHeight="350"
    MouseUp="WindowMouseUp">
    <Window.InputBindings>
        <input:XButtonMouseBinding Gesture="XButton1" Command="{Binding GoBackCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="AppTitleBarButtonStyle" TargetType="{x:Type ButtonBase}">
            <Setter Property="Width" Value="47"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ButtonBase}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{DynamicResource SystemControlHighlightListMediumBrush}"/>
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
            <Button Command="{Binding GoBackCommand}"
                    IsEnabled="{Binding IsBackButtonVisible}"
                    Style="{StaticResource AppTitleBarButtonStyle}">
                <TextBlock Text="&#xE72B;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="12"/>
            </Button>
            <Button Command="{Binding OpenHomeCommand}"
                    ToolTip="{x:Static properties:Strings.Main_Home}"
                    Style="{StaticResource AppTitleBarButtonStyle}">
                <TextBlock Text="&#xE80F;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="14"/>
            </Button>
            <Button Command="{Binding OpenSettingsCommand}"
                    ToolTip="{x:Static properties:Strings.Main_Settings}"
                    Style="{StaticResource AppTitleBarButtonStyle}">
                <TextBlock Text="&#xE713;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="13"/>
            </Button>
        </StackPanel>

        <Grid Grid.Row="1">
            <ui:Frame x:Name="RootFrame"
                      prism:RegionManager.RegionName="FrameRegion">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Navigated">
                        <i:InvokeCommandAction Command="{Binding RootFrameNavigatedCommand}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <ui:Frame.ContentTransitions>
                    <ui:TransitionCollection>
                        <ui:NavigationThemeTransition>
                            <ui:DrillInNavigationTransitionInfo/>
                        </ui:NavigationThemeTransition>
                    </ui:TransitionCollection>
                </ui:Frame.ContentTransitions>
            </ui:Frame>
        </Grid>

        <Grid Grid.Row="2" Background="#5B2C6F"
              Visibility="{Binding IsPlaying, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Margin="8 8 10 8" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
            
                <TextBlock Grid.Column="0" FontSize="12">
                    <Run Text="{x:Static properties:Strings.Main_Monitoring}"/>
                    <Run Text="："/>
                    <Run Text="{Binding ActiveGame.Title}" />
                    <Run Text=" / "/>
                    <Run Text="{Binding ActiveGame.Brand}" />
                </TextBlock>

                <TextBlock Grid.Column="1" FontSize="12">
                    <Run Text="{x:Static properties:Strings.Main_TotalPlayTime}"/>
                    <Run Text="："/>
                    <Run Text="{Binding TotalPlayTime, Converter={StaticResource TimeSpanToZeroPaddingStringWithoutDaysConverter}}"/>
                </TextBlock>
            </Grid>
        </Grid>
    </Grid>
</Window>
