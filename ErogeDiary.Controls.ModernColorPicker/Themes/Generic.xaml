<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ErogeDiary.Controls.ModernColorPicker">

    <controls:ColorToBrushConverter x:Key="ColorToBrushConverter" />

    <Style TargetType="{x:Type controls:ModernColorPicker}">
        <Setter Property="Width" Value="312" />
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ModernColorPicker}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="256" />
                                    <RowDefinition Height="32" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Column="0"
                                      Grid.Row="0">
                                    <Canvas x:Name="PART_ColorField"
                                            ClipToBounds="True"
                                            Cursor="Cross">
                                        <Rectangle Width="{Binding ActualWidth, ElementName=PART_ColorField}"
                                                   Height="{Binding ActualHeight, ElementName=PART_ColorField}">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#FFFF0000" Offset="0" />
                                                    <GradientStop Color="#FFFFFF00" Offset="0.1667" />
                                                    <GradientStop Color="#FF00FF00" Offset="0.3333" />
                                                    <GradientStop Color="#FF00FFFF" Offset="0.5" />
                                                    <GradientStop Color="#FF0000FF" Offset="0.6667" />
                                                    <GradientStop Color="#FFFF00FF" Offset="0.8333" />
                                                    <GradientStop Color="#FFFF0000" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <Rectangle Width="{Binding ActualWidth, ElementName=PART_ColorField}"
                                                   Height="{Binding ActualHeight, ElementName=PART_ColorField}">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00FFFFFF" Offset="0" />
                                                    <GradientStop Color="#FFFFFFFF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <Rectangle Width="{Binding ActualWidth, ElementName=PART_ColorField}"
                                                   Height="{Binding ActualHeight, ElementName=PART_ColorField}"
                                                   Stroke="#33000000"
                                                   StrokeThickness="1" />
                                        <Ellipse x:Name="PART_ColorFieldIndicator"
                                                 Width="16"
                                                 Height="16"
                                                 Stroke="White"
                                                 StrokeThickness="2"
                                                 Fill="Transparent">
                                            <Ellipse.Effect>
                                                <DropShadowEffect BlurRadius="2"
                                                ShadowDepth="0"
                                                Opacity="0.55" />
                                            </Ellipse.Effect>
                                        </Ellipse>
                                    </Canvas>
                                </Grid>

                                <Border Grid.Column="1"
                                        Grid.Row="0"
                                        Margin="12 0 0 0"
                                        BorderBrush="#33000000"
                                        BorderThickness="1"
                                        Background="{Binding SelectedColor, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ColorToBrushConverter}}" />

                                <Canvas x:Name="PART_BrightnessSlider"
                                        Grid.Column="0"
                                        Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Height="12"
                                        Margin="0 20 0 0"
                                        ClipToBounds="False"
                                        Cursor="Hand">
                                    <Rectangle Width="{Binding ActualWidth, ElementName=PART_BrightnessSlider}"
                                               Height="{Binding ActualHeight, ElementName=PART_BrightnessSlider}">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="Black" Offset="0" />
                                                <GradientStop Color="{Binding FieldBaseColor, RelativeSource={RelativeSource TemplatedParent}}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Border x:Name="PART_BrightnessSliderIndicator"
                                            Width="8"
                                            Height="24"
                                            Margin="0 -6 0 0"
                                            Background="#202020"
                                            BorderBrush="White"
                                            BorderThickness="1"
                                            CornerRadius="3" />
                                </Canvas>
                            </Grid>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
